[Unit]
Description=gunicorninstance to server api
After=network.target

[Service]
User=temitayo
Group=temitayo
WorkingDirectory=/home/temitayo/fast-app/src/
Environment="PATH=/home/temitayo/fast-app/venv/bin"
EnvironmentFile=/home/temitayo/fast-app/.env
ExecStart=/home/temitayo/fast-app/venv/bin/gunicorn -w 3 -k uvicorn.workers.UvicornWorker app.main:app --bind 0.0.0.0:7000

[Install]
WantedBy=multi-user.target



server {
    listen 80;
    server_name dev.choicecast.tv;

    location / {
        proxy_pass http://127.0.0.1:3000; 
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
